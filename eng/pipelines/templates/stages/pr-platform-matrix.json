{
  "displayNames": {
    "All": "AllFeatures",
    "Default": "DefaultFeatures"
  },
  "matrix": {
    "Agent": {
      "ubuntu": {
        "OSVmImage": "env:LINUXVMIMAGE",
        "Pool": "env:LINUXPOOL"
      },
      "windows": {
        "OSVmImage": "env:WINDOWSVMIMAGE",
        "Pool": "env:WINDOWSPOOL"
      },
      "macos": {
        "OSVmImage": "env:MACVMIMAGEM1",
        "Pool": "env:MACPOOL"
      }
    },
    "RustToolchainName": [
      "stable",
      "msrv",
      "nightly"
    ],
    "TestFeatureSet": [
      "All"
    ]
  },
  "exclude": [
    {
      "OSVmImage": "env:MACVMIMAGEM1",
      "RustToolchainName": "msrv"
    },
    {
      "OSVmImage": "env:MACVMIMAGEM1",
      "RustToolchainName": "nightly"
    },
    {
      "OSVmImage": "env:WINDOWSVMIMAGE",
      "RustToolchainName": "msrv"
    },
    {
      "OSVmImage": "env:WINDOWSVMIMAGE",
      "RustToolchainName": "nightly"
    }
  ],
  "include": [
    {
      "Agent": {
        "ubuntu": {
          "OSVmImage": "env:LINUXVMIMAGE",
          "Pool": "env:LINUXPOOL"
        }
      },
      "RustToolchainName": "stable",
      "TestFeatureSet": "Default"
    },
    {
      "Agent": {
        "macos": {
          "OSVmImage": "env:MACVMIMAGEM1",
          "Pool": "env:MACPOOL"
        }
      },
      "RustToolchainName": "stable",
      "TestFeatureSet": "Default"
    }
  ]
}
