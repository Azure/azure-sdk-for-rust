    {
      "id": "top_cross_partition_subset",
      "description": "Cross-partition TOP n returns exactly min(n, total) documents. TOP needs no query rewrite (per-partition TOP n plus a global TOP n is already correct); this guards that the SkipTake take-bound is applied once and not doubled.",
      "sources": [
        {
          "sdk": "dotnet",
          "path": "Microsoft.Azure.Cosmos.EmulatorTests/Query/SkipTakeQueryTests.cs",
          "test": "TestQueryCrossPartitionTopAsync"
        }
      ],
      "layers": [
        "inMemoryEmulator"
      ],
      "query": {
        "text": "SELECT TOP 4 c.id FROM c",
        "parameters": []
      },
      "documents": [
        { "id": "d1", "pk": "pk-a" },
        { "id": "d2", "pk": "pk-b" },
        { "id": "d3", "pk": "pk-c" },
        { "id": "d4", "pk": "pk-d" },
        { "id": "d5", "pk": "pk-e" },
        { "id": "d6", "pk": "pk-f" }
      ],
      "partitionCount": 2,
      "assertion": "unorderedSubsetCount",
      "expectedCount": 4
    },
    {
      "id": "top_larger_than_total_all",
      "description": "TOP n with n greater than the total returns every document exactly once. Guards that an over-large take clamps to the available data rather than erroring or truncating.",
      "sources": [
        {
          "sdk": "dotnet",
          "path": "Microsoft.Azure.Cosmos.EmulatorTests/Query/SkipTakeQueryTests.cs",
          "test": "TestQueryCrossPartitionTopAsync"
        }
      ],
