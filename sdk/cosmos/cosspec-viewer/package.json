{
  "name": "cosspec-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Browse cosspec spec-test results in a browser.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cosspec-viewer": "./bin/cosspec-viewer.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "bun run build && bun bin/cosspec-viewer.ts",
    "serve": "bun bin/cosspec-viewer.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.2.1",
    "prettier": "~3.9.10",
    "typescript": "^7.0.2",
    "vite": "~8.3.5"
  }
}
