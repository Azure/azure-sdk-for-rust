{
  "$schema": "schema/shards.v1.json",
  "specVersion": "1.0",
  "maximumDurationMinutes": 20,
  "shards": [
    {
      "id": "pr-core-operations",
      "trigger": "pullRequest",
      "matrix": "../e2e-core-operations-matrix.json",
      "profiles": ["coreOperations"],
      "backends": ["hostedEmulatorGatewayV1", "hostedEmulatorGatewayV2"]
    },
    {
      "id": "pr-configuration-resilience",
      "trigger": "pullRequest",
      "matrix": "../e2e-configuration-resilience-matrix.json",
      "profiles": ["configurationResilience"],
      "backends": ["hostedEmulatorGatewayV1", "hostedEmulatorGatewayV2"]
    },
    {
      "id": "pr-dynamic-topology",
      "trigger": "pullRequest",
      "matrix": "../e2e-dynamic-topology-matrix.json",
      "profiles": ["dynamicTopology"],
      "backends": ["hostedEmulatorGatewayV1", "hostedEmulatorGatewayV2"]
    },
    {
      "id": "scheduled-consistency",
      "trigger": "scheduled",
      "matrix": "../e2e-consistency-matrix.json",
      "profiles": ["lifecycleConsistencyMatrix"],
      "backends": ["hostedEmulatorGatewayV1", "hostedEmulatorGatewayV2"]
    },
    {
      "id": "scheduled-read-consistency-overrides",
      "trigger": "scheduled",
      "matrix": "../e2e-read-consistency-override-matrix.json",
      "profiles": ["readConsistencyOverrideMatrix"],
      "backends": ["hostedEmulatorGatewayV1", "hostedEmulatorGatewayV2"]
    },
    {
      "id": "live-smoke-core",
      "trigger": "live",
      "matrix": "../e2e-live-fixed-matrix.json",
      "profiles": ["smokeTests", "coreOperations"],
      "backends": ["azureLive"]
    },
    {
      "id": "live-configuration",
      "trigger": "live",
      "matrix": "../e2e-live-configuration-matrix.json",
      "profiles": ["liveConfiguration"],
      "backends": ["azureLive"]
    },
    {
      "id": "live-aad-smoke",
      "trigger": "live",
      "matrix": "../e2e-live-aad-matrix.json",
      "profiles": ["smokeTests"],
      "backends": ["azureLive"]
    }
  ]
}
