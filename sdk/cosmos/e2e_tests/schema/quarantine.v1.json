{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.github.io/cosmos-sdk-e2e-tests/quarantine.v1.json",
  "title": "Cosmos SDK E2E quarantine manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "specVersion", "entries"],
  "properties": {
    "$schema": {
      "const": "schema/quarantine.v1.json"
    },
    "specVersion": {
      "const": "1.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "owner", "issue", "reason", "expires", "backends", "profiles"],
        "properties": {
          "scenario": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "owner": {
            "type": "string",
            "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "issue": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "backends": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["hostedEmulatorGatewayV1", "hostedEmulatorGatewayV2", "azureLive"]
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
